module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.Algebra.MvPolynomial.CommRing
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.LinearAlgebra.FiniteDimensional.Basic
public import Lean.Elab.Tactic.Omega

@[expose] public noncomputable section

/-!
# The actual ternary power ideal and finite coefficient coordinates

The ideal is generated by the three monomials X_i^n. Its literal coefficient
criterion and quotient coordinates are proved without reducing polynomials to
finite-field functions. The n=0 zero-quotient case remains legal here; later
Gorenstein uses must impose n>0.
-/

namespace EvenOrderMDS.PowerIdeal

variable {K : Type*} [Field K]

abbrev PolynomialRing (K : Type*) [Field K] := MvPolynomial (Fin 3) K

def powerIdeal (n : ℕ) : Ideal (PolynomialRing K) :=
  Ideal.span ((fun d : Fin 3 →₀ ℕ => MvPolynomial.monomial d (1 : K)) ''
    Set.range (fun i : Fin 3 => Finsupp.single i n))

def InBox (n : ℕ) (d : Fin 3 →₀ ℕ) : Prop := ∀ i : Fin 3, d i < n

abbrev BoxExponent (n : ℕ) := {d : Fin 3 →₀ ℕ // InBox n d}

theorem mem_powerIdeal_iff (n : ℕ) (p : PolynomialRing K) :
    p ∈ powerIdeal (K := K) n ↔ ∀ d ∈ p.support, ∃ i : Fin 3, n ≤ d i := by
  classical
  rw [powerIdeal, MvPolynomial.mem_ideal_span_monomial_image]
  constructor
  · intro h d hd
    obtain ⟨a, ⟨i, rfl⟩, ha⟩ := h d hd
    exact ⟨i, by simpa using ha i⟩
  · intro h d hd
    obtain ⟨i, hi⟩ := h d hd
    refine ⟨Finsupp.single i n, ⟨i, rfl⟩, ?_⟩
    intro j
    by_cases hij : i = j
    · subst j
      simpa using hi
    · simp [hij]

theorem mem_powerIdeal_iff_box_coefficients_zero (n : ℕ) (p : PolynomialRing K) :
    p ∈ powerIdeal (K := K) n ↔
      ∀ d : Fin 3 →₀ ℕ, InBox n d → p.coeff d = 0 := by
  classical
  rw [mem_powerIdeal_iff]
  constructor
  · intro h d hd
    apply Classical.byContradiction
    intro hcoeff
    obtain ⟨i, hi⟩ := h d (MvPolynomial.mem_support_iff.mpr hcoeff)
    have hsmall := hd i
    omega
  · intro h d hd
    apply Classical.byContradiction
    intro hnone
    have hbox : InBox n d := by
      intro i
      exact Nat.lt_of_not_ge (fun hi => hnone ⟨i, hi⟩)
    exact (MvPolynomial.mem_support_iff.mp hd) (h d hbox)

def quotientMap (n : ℕ) : PolynomialRing K →ₐ[K] PolynomialRing K ⧸ powerIdeal (K := K) n :=
  Ideal.Quotient.mkₐ K (powerIdeal (K := K) n)

theorem quotientMap_surjective (n : ℕ) : Function.Surjective (quotientMap (K := K) n) :=
  Ideal.Quotient.mkₐ_surjective K (powerIdeal (K := K) n)

theorem quotientMap_eq_zero_iff (n : ℕ) (p : PolynomialRing K) :
    quotientMap (K := K) n p = 0 ↔
      ∀ d : Fin 3 →₀ ℕ, InBox n d → p.coeff d = 0 := by
  change Ideal.Quotient.mk (powerIdeal (K := K) n) p = 0 ↔ _
  rw [Ideal.Quotient.eq_zero_iff_mem, mem_powerIdeal_iff_box_coefficients_zero]

def boxCoefficient (n : ℕ) (d : Fin 3 →₀ ℕ) (hd : InBox n d) :
    (PolynomialRing K ⧸ powerIdeal (K := K) n) →ₗ[K] K :=
  ((powerIdeal (K := K) n).restrictScalars K).liftQ (MvPolynomial.lcoeff K d)
    (by intro p hp; exact (mem_powerIdeal_iff_box_coefficients_zero n p).mp hp d hd)

theorem boxCoefficient_apply (n : ℕ) (d : Fin 3 →₀ ℕ) (hd : InBox n d)
    (p : PolynomialRing K) :
    boxCoefficient (K := K) n d hd (quotientMap (K := K) n p) = p.coeff d := by
  rfl

def boxEmbedding (n : ℕ) : BoxExponent n → (Fin 3 → Fin n) :=
  fun d i => ⟨d.val i, d.property i⟩

theorem boxEmbedding_injective (n : ℕ) : Function.Injective (boxEmbedding n) := by
  intro a b hab
  apply Subtype.ext
  ext i
  exact congrArg Fin.val (congrFun hab i)

instance boxExponent_finite (n : ℕ) : Finite (BoxExponent n) :=
  Finite.of_injective (boxEmbedding n) (boxEmbedding_injective n)

def coordinates (n : ℕ) :
    (PolynomialRing K ⧸ powerIdeal (K := K) n) →ₗ[K] (BoxExponent n → K) :=
  LinearMap.pi (fun d => boxCoefficient (K := K) n d.val d.property)

theorem coordinates_injective (n : ℕ) : Function.Injective (coordinates (K := K) n) := by
  apply LinearMap.ker_eq_bot.mp
  apply LinearMap.ker_eq_bot'.mpr
  intro u hu
  obtain ⟨p, rfl⟩ := quotientMap_surjective (K := K) n u
  apply (quotientMap_eq_zero_iff n p).mpr
  intro d hd
  exact congrFun hu (⟨d, hd⟩ : BoxExponent n)

instance quotient_finiteDimensional (n : ℕ) :
    FiniteDimensional K (PolynomialRing K ⧸ powerIdeal (K := K) n) :=
  FiniteDimensional.of_injective (coordinates (K := K) n) (coordinates_injective n)

theorem box_monomial_nonzero
    (n : ℕ) (d : Fin 3 →₀ ℕ) (hd : InBox n d) {a : K} (ha : a ≠ 0) :
    quotientMap (K := K) n (MvPolynomial.monomial d a) ≠ 0 := by
  intro hzero
  have hcoeff := (quotientMap_eq_zero_iff n (MvPolynomial.monomial d a)).mp hzero d hd
  apply ha
  simpa using hcoeff

end EvenOrderMDS.PowerIdeal
