module

public import EvenOrderMDS.TruncatedGrading
public import EvenOrderMDS.GradedSocle

@[expose] public noncomputable section

/-!
# The one-dimensional socle of the actual truncated ternary ring

Bounded coefficient coordinates detect every quotient class. If a socle class
had a coefficient below the top exponent in any coordinate, multiplication by
that variable would detect a nonzero bounded coefficient. Hence the socle is
exactly the line generated by the top monomial.
-/

namespace EvenOrderMDS.TruncatedSocle

open PowerIdeal TruncatedGrading

variable {K : Type*} [Field K]

noncomputable def topClass (n : ℕ) : PolynomialRing K ⧸ powerIdeal (K := K) n :=
  quotientMap (K := K) n (MvPolynomial.monomial (topExponent n) 1)

theorem topClass_mem_top (n : ℕ) : topClass (K := K) n ∈ pieces (K := K) n (3 * (n - 1)) := by
  refine ⟨MvPolynomial.monomial (topExponent n) 1, ?_, rfl⟩
  exact MvPolynomial.isHomogeneous_monomial 1 (topExponent_degree n)

theorem topClass_nonzero {n : ℕ} (hn : 1 ≤ n) : topClass (K := K) n ≠ 0 :=
  box_monomial_nonzero n (topExponent n) (topExponent_inBox hn) one_ne_zero

theorem variable_mem_one (n : ℕ) (i : Fin 3) :
    quotientMap (K := K) n (MvPolynomial.X i) ∈ pieces (K := K) n 1 := by
  exact ⟨MvPolynomial.X i, MvPolynomial.isHomogeneous_X K i, rfl⟩

theorem boxCoefficient_mul_variable
    (n : ℕ) (i : Fin 3) (d : Fin 3 →₀ ℕ) (hd : InBox n d)
    (hnext : InBox n (Finsupp.single i 1 + d))
    (u : PolynomialRing K ⧸ powerIdeal (K := K) n) :
    boxCoefficient (K := K) n (Finsupp.single i 1 + d) hnext
      (quotientMap (K := K) n (MvPolynomial.X i) * u) =
        boxCoefficient (K := K) n d hd u := by
  obtain ⟨p, rfl⟩ := quotientMap_surjective (K := K) n u
  rw [← map_mul, boxCoefficient_apply, boxCoefficient_apply, MvPolynomial.coeff_X_mul]

theorem exists_deficient_coordinate
    {n : ℕ} (d : Fin 3 →₀ ℕ) (hd : InBox n d) (hne : d ≠ topExponent n) :
    ∃ i : Fin 3, d i < n - 1 := by
  apply Classical.byContradiction
  intro hnone
  apply hne
  ext i
  rw [topExponent_apply]
  have hsmall := hd i
  have hlarge : n - 1 ≤ d i := Nat.le_of_not_gt (fun h => hnone ⟨i, h⟩)
  omega

theorem increment_stays_inBox
    {n : ℕ} (d : Fin 3 →₀ ℕ) (hd : InBox n d) {i : Fin 3} (hi : d i < n - 1) :
    InBox n (Finsupp.single i 1 + d) := by
  classical
  intro j
  by_cases hij : i = j
  · subst j
    simp only [Finsupp.add_apply, Finsupp.single_eq_same]
    omega
  · simpa [hij] using hd j

theorem socle_lower_coefficient_zero
    {n : ℕ} {u : PolynomialRing K ⧸ powerIdeal (K := K) n}
    (hu : u ∈ GradedSocle.positiveSocle (pieces (K := K) n))
    (d : Fin 3 →₀ ℕ) (hd : InBox n d) (hne : d ≠ topExponent n) :
    boxCoefficient (K := K) n d hd u = 0 := by
  obtain ⟨i, hi⟩ := exists_deficient_coordinate d hd hne
  have hnext := increment_stays_inBox d hd hi
  have hproduct : quotientMap (K := K) n (MvPolynomial.X i) * u = 0 :=
    hu 1 (by decide) _ (variable_mem_one n i)
  have hcoeff := congrArg (boxCoefficient (K := K) n (Finsupp.single i 1 + d) hnext) hproduct
  rw [boxCoefficient_mul_variable n i d hd hnext, map_zero] at hcoeff
  exact hcoeff

theorem socle_element_is_top_multiple
    {n : ℕ} (hn : 1 ≤ n) {u : PolynomialRing K ⧸ powerIdeal (K := K) n}
    (hu : u ∈ GradedSocle.positiveSocle (pieces (K := K) n)) :
    u = (boxCoefficient (K := K) n (topExponent n) (topExponent_inBox hn) u) • topClass (K := K) n := by
  apply coordinates_injective (K := K) n
  funext d
  rcases d with ⟨d, hdBox⟩
  change boxCoefficient (K := K) n d hdBox u =
    boxCoefficient (K := K) n d hdBox
      ((boxCoefficient (K := K) n (topExponent n) (topExponent_inBox hn) u) • topClass (K := K) n)
  rw [map_smul]
  by_cases hd : d = topExponent n
  · subst d
    simp [topClass, boxCoefficient_apply]
  · rw [socle_lower_coefficient_zero hu d hdBox hd]
    simp [topClass, boxCoefficient_apply, MvPolynomial.coeff_monomial, Ne.symm hd]

theorem positiveSocle_eq_top_span {n : ℕ} (hn : 1 ≤ n) :
    GradedSocle.positiveSocle (pieces (K := K) n) =
      Submodule.span K ({topClass (K := K) n} : Set _) := by
  apply le_antisymm
  · intro u hu
    apply Submodule.mem_span_singleton.mpr
    exact ⟨_, (socle_element_is_top_multiple hn hu).symm⟩
  · apply Submodule.span_le.mpr
    intro u hu
    have heq : u = topClass (K := K) n := Set.mem_singleton_iff.mp hu
    rw [heq]
    exact GradedSocle.top_le_positiveSocle (pieces (K := K) n)
      (fun j hj => pieces_above_top n j hj) (topClass_mem_top n)

theorem positiveSocle_dimension {n : ℕ} (hn : 1 ≤ n) :
    Module.finrank K (GradedSocle.positiveSocle (pieces (K := K) n)) = 1 := by
  rw [positiveSocle_eq_top_span hn]
  exact finrank_span_singleton (topClass_nonzero hn)

end EvenOrderMDS.TruncatedSocle
