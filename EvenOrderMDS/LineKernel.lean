module

public import EvenOrderMDS.LineRestriction
public import Mathlib.RingTheory.Ideal.Quotient.Operations

@[expose] public noncomputable section

/-!
# The literal kernel of line restriction

Substituting Z=aX+bY kills exactly the principal ideal generated by
Z-aX-bY. This closes the divisibility step behind the star-point argument.
-/

namespace EvenOrderMDS.LineKernel

open LineRestriction

variable {K : Type*} [Field K]

noncomputable def includeBinary :
    MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin 3) K :=
  MvPolynomial.rename (Fin.castAdd 1)

theorem includeBinary_X (i : Fin 2) :
    includeBinary (K := K) (MvPolynomial.X i) = MvPolynomial.X (i.castAdd 1) := by
  simp [includeBinary]

theorem lineMap_includeBinary (a b : K) (p : MvPolynomial (Fin 2) K) :
    lineMap a b (includeBinary p) = p := by
  have h : (lineMap a b).comp includeBinary = AlgHom.id K (MvPolynomial (Fin 2) K) := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i <;> simp [includeBinary, lineMap]
  exact congrArg (fun f => f p) h

theorem lineMap_eq_zero_iff_divisible_equation (a b : K) (p : MvPolynomial (Fin 3) K) :
    lineMap a b p = 0 ↔
      MvPolynomial.X 2 - a • MvPolynomial.X 0 - b • MvPolynomial.X 1 ∣ p := by
  let L : MvPolynomial (Fin 3) K :=
    MvPolynomial.X 2 - a • MvPolynomial.X 0 - b • MvPolynomial.X 1
  let I : Ideal (MvPolynomial (Fin 3) K) := Ideal.span {L}
  let Q := Ideal.Quotient.mkₐ K I
  have hL : Q L = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.subset_span (Set.mem_singleton L)
  have hcomp : Q.comp (includeBinary.comp (lineMap a b)) = Q := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    · simp [AlgHom.comp_apply, includeBinary, lineMap_X_zero]
    · simp [AlgHom.comp_apply, includeBinary, lineMap_X_one]
    · change Q (includeBinary (lineMap a b (MvPolynomial.X 2))) = Q (MvPolynomial.X 2)
      rw [lineMap_X_two]
      simp only [map_add, map_smul, includeBinary_X]
      change a • Q (MvPolynomial.X 0) + b • Q (MvPolynomial.X 1) = Q (MvPolynomial.X 2)
      have hL' : Q (MvPolynomial.X 2) -
          (a • Q (MvPolynomial.X 0) + b • Q (MvPolynomial.X 1)) = 0 := by
        simpa only [L, map_sub, map_smul, sub_add_eq_sub_sub] using hL
      exact (sub_eq_zero.mp hL').symm
  constructor
  · intro hp
    have hz : Q p = 0 := by
      rw [← hcomp]
      simp only [AlgHom.comp_apply, hp, map_zero]
    exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hz)
  · exact lineMap_of_divisible_equation a b

end EvenOrderMDS.LineKernel
